rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function sharedFolder(folderId) { return get(/databases/$(database)/documents/sharedFolders/$(folderId)); }
    function membership(folderId) { return get(/databases/$(database)/documents/sharedFolders/$(folderId)/members/$(request.auth.uid)); }
    function sharedOwner(folderId) { return signedIn() && sharedFolder(folderId).data.ownerId == request.auth.uid; }
    function sharedOwnerAfter(folderId) { return signedIn() && getAfter(/databases/$(database)/documents/sharedFolders/$(folderId)).data.ownerId == request.auth.uid; }
    function sharedMember(folderId) { return signedIn() && exists(/databases/$(database)/documents/sharedFolders/$(folderId)/members/$(request.auth.uid)); }
    function sharedEditor(folderId) { return sharedMember(folderId) && membership(folderId).data.role in ['owner','editor']; }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && request.resource.data.uid == uid;
      allow update: if isOwner(uid) && resource.data.uid == uid && request.resource.data.uid == uid;
      allow delete: if false;
      match /friends/{friendId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && (friendId != 'me' || (request.resource.data.isMe == true && request.resource.data.archived == false)) && ((!request.resource.data.keys().hasAny(['linkedUserId']) || request.resource.data.linkedUserId == null) || (request.resource.data.linkedByRequestId is string && get(/databases/$(database)/documents/accountLinkRequests/$(request.resource.data.linkedByRequestId)).data.status == 'accepted' && get(/databases/$(database)/documents/accountLinkRequests/$(request.resource.data.linkedByRequestId)).data.targetUid == uid && get(/databases/$(database)/documents/accountLinkRequests/$(request.resource.data.linkedByRequestId)).data.requesterUid == request.resource.data.linkedUserId));
        allow update: if (isOwner(uid)
          && !(friendId == 'me' && (request.resource.data.isMe != true || request.resource.data.archived != false))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['linkedUserId','linkedEmail','linkedDisplayName','linkedByRequestId']) || request.resource.data.linkedUserId == null))
          || (signedIn()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['linkedUserId','linkedEmail','linkedDisplayName','linkedByRequestId','updatedAt'])
            && request.resource.data.linkedUserId == request.auth.uid
            && request.resource.data.linkedByRequestId is string
            && getAfter(/databases/$(database)/documents/accountLinkRequests/$(request.resource.data.linkedByRequestId)).data.status == 'accepted'
            && getAfter(/databases/$(database)/documents/accountLinkRequests/$(request.resource.data.linkedByRequestId)).data.requesterUid == uid
            && getAfter(/databases/$(database)/documents/accountLinkRequests/$(request.resource.data.linkedByRequestId)).data.requesterFriendId == friendId
            && getAfter(/databases/$(database)/documents/accountLinkRequests/$(request.resource.data.linkedByRequestId)).data.targetUid == request.auth.uid
            && request.resource.data.linkedDisplayName == getAfter(/databases/$(database)/documents/accountLinkRequests/$(request.resource.data.linkedByRequestId)).data.targetNameSnapshot
            && request.resource.data.linkedEmail == getAfter(/databases/$(database)/documents/accountLinkRequests/$(request.resource.data.linkedByRequestId)).data.targetEmailSnapshot);
        allow delete: if false;
        match /paymentMethods/{methodId} { allow read, write: if isOwner(uid); }
      }
      match /paymentMethods/{methodId} {
        allow read: if isOwner(uid) || (signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)/friendLinks/$(uid)));
        allow create, update, delete: if isOwner(uid);
      }
      match /friendLinks/{linkedUid} {
        allow read: if isOwner(uid);
        allow create: if signedIn() && ((request.auth.uid == linkedUid
          && request.resource.data.accountLinkRequestId is string
          && getAfter(/databases/$(database)/documents/accountLinkRequests/$(request.resource.data.accountLinkRequestId)).data.status == 'accepted'
          && getAfter(/databases/$(database)/documents/accountLinkRequests/$(request.resource.data.accountLinkRequestId)).data.requesterUid == uid
          && getAfter(/databases/$(database)/documents/accountLinkRequests/$(request.resource.data.accountLinkRequestId)).data.requesterFriendId == request.resource.data.friendId
          && getAfter(/databases/$(database)/documents/accountLinkRequests/$(request.resource.data.accountLinkRequestId)).data.targetUid == linkedUid) || (isOwner(uid) && getAfter(/databases/$(database)/documents/accountLinkRequests/$(request.resource.data.accountLinkRequestId)).data.status == 'accepted' && getAfter(/databases/$(database)/documents/accountLinkRequests/$(request.resource.data.accountLinkRequestId)).data.targetUid == uid && getAfter(/databases/$(database)/documents/accountLinkRequests/$(request.resource.data.accountLinkRequestId)).data.requesterUid == linkedUid));
        allow update: if false;
        allow delete: if isOwner(uid);
      }
      match /friendGroups/{groupId} { allow read, write: if isOwner(uid); }
      match /sharedFolderMemberships/{folderId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && request.resource.data.userId == uid && request.resource.data.folderId == folderId && existsAfter(/databases/$(database)/documents/sharedFolders/$(folderId)/members/$(uid));
        allow delete: if isOwner(uid) || sharedOwner(folderId);
      }
      match /folders/{folderId} {
        allow read, write: if isOwner(uid);
        match /contributions/{contributionId} {
          allow read: if isOwner(uid);
          allow create: if isOwner(uid) && request.resource.data.createdByUserId == request.auth.uid;
          allow update: if isOwner(uid) && ((!resource.data.keys().hasAny(['createdByUserId']) && !request.resource.data.keys().hasAny(['createdByUserId'])) || request.resource.data.createdByUserId == resource.data.createdByUserId);
          allow delete: if isOwner(uid);
          match /expenses/{expenseId} { allow read, write: if isOwner(uid); }
        }
      }
      match /settlements/{settlementId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) || (signedIn() && request.resource.data.requestId is string && getAfter(/databases/$(database)/documents/settlementRequests/$(request.resource.data.requestId)).data.requesterUid == uid && getAfter(/databases/$(database)/documents/settlementRequests/$(request.resource.data.requestId)).data.approverUid == request.auth.uid && getAfter(/databases/$(database)/documents/settlementRequests/$(request.resource.data.requestId)).data.status == 'approved');
        allow delete: if isOwner(uid);
      }
      match /notifications/{notificationId} {
        allow read: if isOwner(uid);
        allow create: if signedIn() && request.resource.data.recipientUid == uid && request.resource.data.actorUid == request.auth.uid;
        allow update: if isOwner(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
        allow delete: if false;
      }
      match /activities/{activityId} { allow read, write: if isOwner(uid); }
    }

    match /publicProfiles/{uid} { allow read: if signedIn(); allow create, update: if isOwner(uid) && request.resource.data.uid == uid; allow delete: if false; }
    match /userDirectory/{lookupId} { allow get: if signedIn(); allow list: if false; allow create: if signedIn() && request.resource.data.uid == request.auth.uid; allow update: if signedIn() && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid; allow delete: if false; }

    match /sharedFolders/{folderId} {
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow read: if signedIn() && (resource.data.ownerId == request.auth.uid || sharedMember(folderId));
      allow update: if sharedOwner(folderId) && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if sharedOwner(folderId);
      match /members/{memberId} {
        allow read: if signedIn() && (request.auth.uid == memberId || resource.data.userId == request.auth.uid || sharedOwner(folderId));
        allow create: if sharedOwner(folderId) || (request.auth.uid == memberId && request.resource.data.role == 'owner' && getAfter(/databases/$(database)/documents/sharedFolders/$(folderId)).data.ownerId == request.auth.uid) || (request.auth.uid == memberId && get(/databases/$(database)/documents/folderInvitations/$(folderId + '_' + memberId)).data.status == 'pending' && request.resource.data.role == get(/databases/$(database)/documents/folderInvitations/$(folderId + '_' + memberId)).data.role);
        allow update, delete: if sharedOwner(folderId) && memberId != sharedFolder(folderId).data.ownerId;
      }
      match /people/{personId} {
        allow read: if sharedMember(folderId);
        allow create: if sharedOwner(folderId) || sharedOwnerAfter(folderId);
        allow update, delete: if sharedOwner(folderId);
      }
      match /personRequests/{requestId} {
        allow read: if sharedMember(folderId);
        allow create: if sharedEditor(folderId) && request.resource.data.folderId == folderId && request.resource.data.proposerUid == request.auth.uid && request.resource.data.status == 'pending' && request.resource.data.people is list && request.resource.data.people.size() > 0;
        allow update: if sharedOwner(folderId) && resource.data.status == 'pending' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','respondedAt','respondedBy']) && request.resource.data.status in ['approved','rejected'] && request.resource.data.respondedBy == request.auth.uid;
        allow delete: if false;
      }
      match /settlements/{settlementId} { allow read: if sharedMember(folderId); allow write: if sharedEditor(folderId) || getAfter(/databases/$(database)/documents/sharedFolders/$(folderId)).data.ownerId == request.auth.uid; }
      match /contributions/{contributionId} {
        allow read: if sharedMember(folderId);
        allow create: if (sharedEditor(folderId) && request.resource.data.createdByUserId == request.auth.uid) || (getAfter(/databases/$(database)/documents/sharedFolders/$(folderId)).data.ownerId == request.auth.uid && (!request.resource.data.keys().hasAny(['createdByUserId']) || request.resource.data.createdByUserId == request.auth.uid));
        allow update: if sharedEditor(folderId) && ((!resource.data.keys().hasAny(['createdByUserId']) && !request.resource.data.keys().hasAny(['createdByUserId'])) || request.resource.data.createdByUserId == resource.data.createdByUserId);
        allow delete: if sharedEditor(folderId);
        match /expenses/{expenseId} { allow read: if sharedMember(folderId); allow write: if sharedEditor(folderId) || getAfter(/databases/$(database)/documents/sharedFolders/$(folderId)).data.ownerId == request.auth.uid; }
      }
    }
    match /folderInvitations/{invitationId} {
      allow read: if signedIn() && (resource.data.recipientUid == request.auth.uid || resource.data.ownerId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid && sharedOwner(request.resource.data.folderId) && request.resource.data.role in ['editor','viewer'] && request.resource.data.status == 'pending' && request.resource.data.recipientUid != request.auth.uid;
      allow update: if signedIn() && ((resource.data.recipientUid == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','respondedAt']) && request.resource.data.status in ['accepted','declined']) || (resource.data.ownerId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','respondedAt']) && request.resource.data.status == 'cancelled') || (resource.data.ownerId == request.auth.uid && sharedOwner(resource.data.folderId) && resource.data.status in ['declined','cancelled'] && request.resource.data.ownerId == resource.data.ownerId && request.resource.data.recipientUid == resource.data.recipientUid && request.resource.data.folderId == resource.data.folderId && request.resource.data.role in ['editor','viewer'] && request.resource.data.status == 'pending'));
      allow delete: if false;
    }
    match /settlementRequests/{requestId} {
      allow create: if signedIn() && request.resource.data.requesterUid == request.auth.uid && request.resource.data.approverUid != request.auth.uid && request.resource.data.status == 'pending';
      allow read: if signedIn() && (resource.data.requesterUid == request.auth.uid || resource.data.approverUid == request.auth.uid);
      allow update: if signedIn() && resource.data.status == 'pending' && ((resource.data.approverUid == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','respondedAt','disapprovalReason']) && request.resource.data.status in ['approved','disapproved']) || (resource.data.requesterUid == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','respondedAt']) && request.resource.data.status == 'cancelled'));
      allow delete: if false;
    }
    match /accountLinkRequests/{requestId} {
      allow create: if signedIn()
        && request.resource.data.requesterUid == request.auth.uid
        && request.resource.data.targetUid != request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.requesterFriendId is string
        && request.resource.data.requesterFriendNameSnapshot is string
        && request.resource.data.requesterNameSnapshot is string
        && request.resource.data.targetNameSnapshot is string
        && request.resource.data.targetEmailSnapshot is string;
      allow read: if signedIn() && (resource.data.requesterUid == request.auth.uid || resource.data.targetUid == request.auth.uid);
      allow update: if signedIn() && resource.data.status == 'pending'
        && ((resource.data.targetUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','respondedAt','declineReason'])
          && request.resource.data.status in ['accepted','declined'])
        || (resource.data.requesterUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','respondedAt'])
          && request.resource.data.status == 'cancelled'));
      allow delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
